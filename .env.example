APP_ENV=development
# Generate a unique secret: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-generated-secret-before-running
FRONTEND_URL=http://localhost:3000
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://clipforge:replace-this-password@localhost:5432/clipforge
REDIS_URL=redis://localhost:6379/0

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Video Repurposer
SMTP_STARTTLS=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

AI_PROVIDER=openai
AI_MODEL=
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_CACHE=./data/models
PROCESSING_MAX_CLIPS=10
PROCESSING_MIN_CLIP_SECONDS=20
PROCESSING_MAX_CLIP_SECONDS=60
VIDEO_SAMPLE_INTERVAL_SECONDS=1.0
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_VIDEO_BITRATE=5M

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/uploads
MAX_UPLOAD_BYTES=2147483648
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ENDPOINT_URL=
AWS_S3_PREFIX=clipforge

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
